{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nemoris",
  "version": "1.2.0",
  "identifier": "com.nemoris.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/nemoris-backend/": "backend"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMkQxODg2OEJDNzExOUUKUldTZUVjZUxoaGd0d25UWXdRdzBkenlvYTIvdWlaeXpmcThoanhrUXVZb013allIUS9YVlFpUEwK",
      "endpoints": [
        "https://github.com/Liphis01/quiz-app/releases/latest/download/latest.json"
      ]
    }
  }
}
